{
  "name": "ilab-media-scheduler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --open",
    "dev:local": "vite --host 127.0.0.1",
    "dev:phone": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:brief": "rm -rf .tmp-test && tsc --ignoreConfig --skipLibCheck --outDir .tmp-test --target es2023 --module nodenext --moduleResolution nodenext --types node api/_lib/scheduler.ts tests/scheduler-brief.test.ts && node --test .tmp-test/tests/scheduler-brief.test.js",
    "preview": "vite preview --host 127.0.0.1 --open"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
